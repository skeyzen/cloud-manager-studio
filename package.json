{
  "name": "cloud-manager-studio",
  "productName": "Cloud Manager Studio",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Gennaro Secondulfo",
    "url": "https://github.com/skeyzen",
    "linkedin": "https://www.linkedin.com/in/gennaro-secondulfo-dev/"
  },
  "license": "MIT",
  "description": "Desktop toolbox suite for Adobe I/O Cloud Manager and App Builder",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently --kill-others-on-fail \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/electron/main.js\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test:runner": "node --import tsx --test electron/aio-process-runner.test.ts electron/aio-cli-invocation.test.ts electron/setup-actions.test.ts src/output-search.test.ts src/welcome-messages.test.ts src/app-log.test.ts src/cloud-manager-context.test.ts",
    "build:win": "npm run build && electron-builder --win portable",
    "build:win:dir": "npm run build && electron-builder --win --dir",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@adobe/aio-cli": "11.2.0",
    "@adobe/aio-cli-plugin-cloudmanager": "4.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.skeyzen.cloud-manager-studio",
    "productName": "Cloud Manager Studio",
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "!.aio/**",
      "!logs/**",
      "!z_*/**",
      "!**/*.test.*",
      "!dist-electron/**/*.test.js",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "portable": {
      "splashImage": "build/CloudManagerStudio_Splash_Skeyzen.bmp"
    }
  }
}
